[Unit]
Description=Trellis Promo Studio render worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__TRELLIS_REPO_ROOT__/workers/clip-render-worker
EnvironmentFile=/etc/trellis/promo-render.env
ExecStart=__NODE_BIN__/node promo-worker.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
