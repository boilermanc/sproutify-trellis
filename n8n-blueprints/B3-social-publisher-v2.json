    {
      "parameters": {
        "jsCode": "const credentials = $input.first().json;\nconst body = $('Webhook').first().json.body || {};\nif (!credentials.success) throw new Error('Credential lookup failed: ' + (credentials.error || 'unknown error'));\nconst igAccountId = credentials.platform_metadata?.instagram_business_account_id;\nconst accessToken = (credentials.access_token || '').trim();\nif (!igAccountId) throw new Error('instagram_business_account_id missing from platform_metadata');\nif (!accessToken) throw new Error('access_token came back null');\nconst mediaUrls = Array.isArray(body.media_urls) && body.media_urls.length ? body.media_urls : (body.image_url ? [body.image_url] : []);\nconst mediaType = body.media_type || (mediaUrls.length > 1 ? 'carousel' : 'image');\nif (!['image', 'video', 'carousel'].includes(mediaType)) throw new Error('media_type must be image, video, or carousel');\nif (mediaType !== 'image' && !mediaUrls.length) throw new Error('Media URL is required for Reels and carousels');\nif (mediaType === 'video' && mediaUrls.length !== 1) throw new Error('A Reel requires exactly one video URL');\nif (mediaType === 'carousel' && (mediaUrls.length < 2 || mediaUrls.length > 10)) throw new Error('A carousel requires 2 to 10 image URLs');\nreturn [{ json: { ig_account_id: igAccountId, access_token: accessToken, branch_id: body.branch_id, caption: body.caption, media_type: mediaType, media_urls: mediaUrls, image_url: mediaUrls[0] || null, scheduled_for: body.scheduled_for || null } }];"
      },
