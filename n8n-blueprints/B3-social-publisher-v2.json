      "parameters": {
        "jsCode": "const children = $input.all().map(item => item.json.id).filter(Boolean);\nconst source = $('Extract & Normalize Request').first().json;\nif (children.length !== source.media_urls.length) throw new Error('One or more carousel child containers failed');\nreturn [{ json: { ...source, children } }];"
