      "parameters": {
        "method": "POST",
        "url": "https://queue.fal.run/fal-ai/kling-video/v2.6/pro/image-to-video",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ prompt: $('Build Motion Prompt').item.json.prompt, negative_prompt: $('Build Motion Prompt').item.json.negative_prompt, image_url: $('Build Motion Prompt').item.json.image_url, duration: $('Build Motion Prompt').item.json.duration, generate_audio: false }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "submit-kling-falai",
      "name": "Submit Kling (Fal.ai)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
