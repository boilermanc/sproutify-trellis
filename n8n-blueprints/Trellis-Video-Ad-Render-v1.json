          "id": "REPLACE_FAL_CRED",
          "name": "Fal.ai API"
        }
      },
      "onError": "continueErrorOutput",
      "notes": "image-to-video, NOT text-to-video.\nNo aspect_ratio - it is inherited from the frame.\ngenerate_audio:false - we supply our own audio."
    },
