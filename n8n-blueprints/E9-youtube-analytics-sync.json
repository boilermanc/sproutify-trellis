    {
      "parameters": {
        "method": "GET",
        "url": "https://youtubeanalytics.googleapis.com/v2/reports",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "ids",
              "value": "channel==MINE"
            },
            {
              "name": "startDate",
              "value": "={{ $('Build Video Jobs').item.json.start_date }}"
            },
            {
              "name": "endDate",
              "value": "={{ $('Build Video Jobs').item.json.end_date }}"
            },
            {
              "name": "metrics",
              "value": "views,estimatedMinutesWatched,averageViewDuration,averageViewPercentage,subscribersGained,subscribersLost"
            },
            {
              "name": "dimensions",
              "value": "day"
            },
            {
              "name": "filters",
              "value": "={{ 'video==' + $('Build Video Jobs').item.json.youtube_video_id }}"
            },
            {
              "name": "sort",
              "value": "day"
            }
          ]
        },
        "options": {}
      },
      "name": "YouTube Daily Analytics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1280,
        260
      ],
      "credentials": {
        "googleOAuth2Api": {
          "id": "REPLACE_WITH_GOOGLE_ANALYTICS_CREDENTIAL",
          "name": "Trellis YouTube Analytics"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const analyticsItems = $input.all();\nconst jobItems = $items('Build Video Jobs');\nconst statsItems = $items('YouTube Video Stats');\nconst output = [];\n\nfunction numberValue(value) {\n  const n = Number(value || 0);\n  return Number.isFinite(n) ? n : 0;\n}\n\nfunction buildRow(job, stats, values) {\n  const date = String(values.day || job.end_date).slice(0, 10);\n  return {\n    episode_id: job.episode_id,\n    publication_id: job.publication_id,\n    youtube_video_id: job.youtube_video_id,\n    metric_date: date,\n    views: Math.round(numberValue(values.views)),\n    engaged_views: 0,\n    estimated_minutes_watched: numberValue(values.estimatedMinutesWatched),\n    average_view_duration: numberValue(values.averageViewDuration),\n    average_view_percentage: numberValue(values.averageViewPercentage),\n    likes: Math.round(numberValue(stats.likeCount)),\n    comments: Math.round(numberValue(stats.commentCount)),\n    shares: 0,\n    subscribers_gained: Math.round(numberValue(values.subscribersGained)),\n    subscribers_lost: Math.round(numberValue(values.subscribersLost)),\n    traffic_sources: {},\n    countries: {},\n    raw: {\n      analytics_row: values,\n      public_statistics: stats,\n      external_url: job.external_url,\n      sync_window: { start_date: job.start_date, end_date: job.end_date }\n    },\n    synced_at: new Date().toISOString()\n  };\n}\n\nanalyticsItems.forEach((item, index) => {\n  const analytics = item.json || {};\n  const job = jobItems[index]?.json;\n  const stats = statsItems[index]?.json?.items?.[0]?.statistics || {};\n  if (!job) return;\n\n  const headers = Array.isArray(analytics.columnHeaders) ? analytics.columnHeaders.map(h => h.name) : [];\n  const rows = Array.isArray(analytics.rows) ? analytics.rows : [];\n\n  if (!rows.length) {\n    output.push({ json: buildRow(job, stats, { day: job.end_date }) });\n    return;\n  }\n\n  for (const row of rows) {\n    const values = {};\n    headers.forEach((name, headerIndex) => { values[name] = row[headerIndex]; });\n    output.push({ json: buildRow(job, stats, values) });\n  }\n});\n\nreturn output;"
      },
