        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: $('Prepare Prompt').item.json.frame_prompt + ($('Prepare Prompt').item.json.is_regenerate ? ' Vary the composition and lighting from previous attempts while keeping the same subject and setting.' : '') }] }], generationConfig: { responseModalities: ['IMAGE'], imageConfig: { aspectRatio: $('Prepare Prompt').item.json.aspect_ratio } } }) }}",
        "options": {
