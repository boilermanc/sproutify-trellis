    {
      "parameters": {
        "operation": "getAll",
        "tableId": "brand_profiles",
        "returnAll": true,
        "filterType": "string",
        "filterString": "=branch=like.{{ $('Webhook').item.json.body.branch }}*"
      },
      "id": "lookup-brand-profile",
      "name": "Lookup Brand Profile",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        560,
        0
      ],
      "credentials": {
        "supabaseApi": {
          "id": "IkIpi5m4OmJ9DvBS",
