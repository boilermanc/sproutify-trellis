      },
      "id": "generate-frame-nano-banana",
      "name": "Generate Frame (Nano Banana)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1660,
        0
      ],
      "credentials": {
        "httpQueryAuth": {
          "id": "REPLACE_GEMINI_CRED",
          "name": "Gemini API"
        }
      },
      "onError": "continueErrorOutput",
      "notes": "Nano Banana 2. Returns inlineData base64 in candidates[].content.parts[]."
    },
    {
      "parameters": {
        "jsCode": "// Nano Banana returns content parts; the image arrives as inlineData base64.\nconst cands = $json.candidates || [];\nlet b64 = null;\nlet mime = 'image/png';\n\nfor (const c of cands) {\n  const parts = (c.content && c.content.parts) || [];\n  for (const p of parts) {\n    const inline = p.inlineData || p.inline_data;\n    if (inline && inline.data) {\n      b64 = inline.data;\n      mime = inline.mimeType || inline.mime_type || mime;\n      break;\n    }\n  }\n  if (b64) break;\n}\n\nif (!b64) {\n  throw new Error('No image returned by Gemini. Raw: ' + JSON.stringify($json).slice(0, 400));\n}\n\nconst jobId = $('Prepare Prompt').item.json.job_id;\nconst attempt = Number($('Read Job').item.json.frame_attempt || 0) + 1;\nconst ext = mime.includes('jpeg') ? 'jpg' : 'png';\n// upsert:false + randomised suffix -> avoids UPDATE RLS policy on Storage\nconst rand = Math.random().toString(36).slice(2, 8);\nconst path = `video-ad-frames/${jobId}/frame-${attempt}-${rand}.${ext}`;\n\nreturn [{\n  json: { storage_path: path, mime, attempt },\n  binary: {\n    data: {\n      data: b64,\n      mimeType: mime,\n      fileName: `frame-${attempt}-${rand}.${ext}`,\n    },\n  },\n}];"
      },
      "id": "extract-image",
      "name": "Extract Image",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1880,
        0
      ],
      "onError": "continueErrorOutput"
    },
