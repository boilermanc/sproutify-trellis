    {
      "parameters": {
        "jsCode": "const body = $('Webhook').item.json.body;\nconst brandItem = $('Lookup Brand Profile').all()[0];\nconst brand = brandItem ? brandItem.json : {};\n\nconst brandName = brand.brand_name || body.branch || 'the brand';\nconst tone = body.tone || brand.default_tone || 'friendly';\nconst pron = brand.pronunciation_guide || '';\nconst pipeline = body.pipeline || 'talking_head';\n\n// Duration: Kling accepts 5 or 10 only.\nconst dur = (Number(body.video_duration) || 5) <= 5 ? 5 : 10;\n\n// Script length must FIT the clip. ~2.2 wps, and leave ~1s of head/tail room.\nconst maxWords = Math.max(6, Math.floor((dur - 1) * 2.2));\n\nconst aspect = body.aspect_ratio || '9:16';\nconst gender = body.actor_gender || 'female';\nconst style = body.actor_style || 'professional';\nconst setting = body.setting || brand.default_setting || 'a clean, modern, well-lit interior';\n\nconst hook = body.platform === 'tiktok'\n  ? 'Write a HOOK-FIRST viral vertical video script that grabs attention in the first 2 seconds. Punchy, conversational, fast-paced.'\n  : 'Write a performance-marketing video ad script.';\n\nconst script_prompt = `${hook} Brand: ${brandName}. Product: ${body.product_description || ''}. Audience: ${body.target_segment || 'general audience'}. Tone: ${tone}. Call to action: ${body.cta || 'Learn more'}. Pronunciation and brand rules: ${pron}. Write ONLY the spoken words - no stage directions, no parentheticals like (smiling), no narrator labels. Maximum ${maxWords} words. Conversational, natural.`;\n\n// ---- FIRST-FRAME IMAGE PROMPT ----\n// This describes a STILL PHOTOGRAPH. No motion, no speech, no narrative.\nconst frameBase = pipeline === 'full_scene'\n  ? `A single still photograph. Vertical ${aspect} composition. Product-forward marketing photograph for ${brandName}. Setting: ${setting}. The product is the clear focal point, positioned in the centre third of the frame.`\n  : `A single still photograph. Vertical ${aspect} composition. Medium-close portrait of one ${style} ${gender} person, alone in frame, already standing in place and facing the camera directly. Setting: ${setting}. Mouth closed, neutral-warm expression, eyes to camera. Head and shoulders occupy the centre of the frame with clear headroom above.`;\n\nconst frameStyle = `Photorealistic. Natural professional lighting, soft key from camera left. Shallow depth of field. Realistic skin texture and film grain. Colour palette consistent with ${brandName}. No text, no logos, no watermarks, no captions, no borders, no collage, no split screen. Only one person in frame. Sharp focus, correct anatomy, natural hands.`;\n\nconst frame_prompt = `${frameBase} ${frameStyle}`;\n\nreturn [{ json: {\n  script_prompt,\n  frame_prompt,\n  brand_name: brandName,\n  duration: String(dur),\n  pipeline,\n  aspect_ratio: aspect,\n  setting,\n  actor_gender: gender,\n  actor_style: style,\n  job_id: body.job_id,\n  branch: body.branch,\n  is_regenerate: body.regenerate === true,\n} }];"
      },
      "id": "prepare-prompt",
      "name": "Prepare Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ]
    },
