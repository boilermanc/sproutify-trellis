            }
          ]
        }
      },
      "name": "Fail Studio Album Publishing",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1480,
        560
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_WITH_YOUR_HUB_SUPABASE_CREDENTIAL",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "resource": "row",
