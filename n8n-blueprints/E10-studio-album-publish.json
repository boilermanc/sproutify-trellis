            },
            {
              "fieldId": "updated_at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "name": "Fail Studio Publish Job",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1700,
        560
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_WITH_YOUR_HUB_SUPABASE_CREDENTIAL",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "content": "## Trellis: Studio Album Publish (YouTube)\\n\\nDedicated, account-aware Studio publisher. The payload must include `youtube_account_id`; E11 resolves that exact Rekkrd channel and performs the resumable upload.\\n\\n### Setup\\n1. Import E11-youtube-account-upload first. It is an internal sub-workflow and does not need activation.\\n2. Set Upload Studio Album to YouTube to **By ID** and replace `REPLACE_WITH_E11_WORKFLOW_ID` with E11's workflow ID.\\n3. Map every Supabase node to the Hub service-role credential.\\n4. Keep the first release private while validating the destination.\\n\\nThe thumbnail call reuses E11's short-lived access token. Scheduling stays disabled until verified end to end. Google credentials remain in Trellis.",
        "width": 560,
        "height": 460
      },
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        100,
        -220
      ]
    }
  ],
