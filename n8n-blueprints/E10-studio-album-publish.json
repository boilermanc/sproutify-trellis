              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Build Studio Failure').item.json.job_id }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
