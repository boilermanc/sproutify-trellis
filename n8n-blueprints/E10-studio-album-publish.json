{
  "name": "Trellis: Studio Album Publish (YouTube)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "trellis-studio-album-publish",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Studio Publish Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        160,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body || $json;\nfor (const key of ['publication_id','job_id','album_id','organization_id','video_url']) if (!b[key]) throw new Error('Missing required Studio publish field: ' + key);\nif (b.pipeline !== 'studio' || b.platform !== 'youtube') throw new Error('Only Studio YouTube publishing is accepted');\nconst m = b.metadata || {};\nconst chapters = Array.isArray(m.chapters) ? m.chapters : [];\nconst chapterLines = chapters.map(c => `${c.time || '0:00'} ${c.title || ''}`.trim()).filter(Boolean).join('\\n');\nconst description = [String(m.description || '').trim(), chapterLines ? 'Chapters:\\n' + chapterLines : ''].filter(Boolean).join('\\n\\n').slice(0, 4900);\nconst tags = (Array.isArray(m.tags) ? m.tags : []).map(v => String(v || '').replace(/^#+/, '').trim()).filter(Boolean).slice(0, 15).join(',');\nreturn { json: { ...b, title: String(m.title || 'Untitled Album').slice(0, 95), description, tags, visibility: ['private','unlisted','public'].includes(b.visibility) ? b.visibility : 'private' } };"
      },
      "name": "Validate Studio Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "onError": "continueErrorOutput",
      "position": [
        380,
        300
      ]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "studio_publications",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Validate Studio Payload').item.json.publication_id }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "submitting"
            },
            {
              "fieldId": "updated_at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "name": "Mark Studio Uploading",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "onError": "continueErrorOutput",
      "position": [
        600,
        300
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_WITH_YOUR_HUB_SUPABASE_CREDENTIAL",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const m = $('Validate Studio Payload').item.json;\nif (!m.youtube_account_id) throw new Error('Missing youtube_account_id');\nreturn { json: { ...m, category_id: '10' } };"
      },
      "name": "Prepare Studio Account Upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "onError": "continueErrorOutput",
      "position": [
        820,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "REPLACE_WITH_E11_WORKFLOW_ID",
          "mode": "id"
        },
        "options": { "waitForSubWorkflow": true }
      },
      "name": "Upload Studio Album to YouTube",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "onError": "continueErrorOutput",
      "position": [
        1040,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const y = $json || {}; let id = typeof y.id === 'object' ? y.id?.videoId : y.id; id = id || y?.snippet?.resourceId?.videoId || y.videoId || y.uploadId; if (!/^[A-Za-z0-9_-]{11}$/.test(String(id || ''))) throw new Error('YouTube upload returned no usable video id: ' + JSON.stringify(y).slice(0, 200)); return { json: { video_id: id, youtube_url: 'https://youtu.be/' + id, access_token: y.access_token, youtube_account_id: y.youtube_account_id } };"
      },
      "name": "Extract Studio Video ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "onError": "continueErrorOutput",
      "position": [
        1260,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Validate Studio Payload').item.json.thumbnail_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "thumb"
            }
          },
          "timeout": 120000
        }
      },
      "name": "Download Studio Thumbnail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "onError": "continueRegularOutput",
      "position": [
        1480,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://www.googleapis.com/upload/youtube/v3/thumbnails/set?videoId={{ $('Extract Studio Video ID').item.json.video_id }}&uploadType=media",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Authorization", "value": "={{ 'Bearer ' + $('Extract Studio Video ID').item.json.access_token }}" }
        ] },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "thumb",
        "options": {
          "timeout": 120000
        }
      },
      "name": "Set Studio Thumbnail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "onError": "continueRegularOutput",
      "position": [
        1700,
        300
      ]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "studio_publications",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Validate Studio Payload').item.json.publication_id }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "live"
            },
            {
              "fieldId": "external_id",
              "fieldValue": "={{ $('Extract Studio Video ID').item.json.video_id }}"
            },
            {
              "fieldId": "external_url",
              "fieldValue": "={{ $('Extract Studio Video ID').item.json.youtube_url }}"
            },
            {
              "fieldId": "published_at",
              "fieldValue": "={{ $now.toISO() }}"
            },
            {
              "fieldId": "updated_at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "name": "Mark Studio Publication Live",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1480,
        220
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_WITH_YOUR_HUB_SUPABASE_CREDENTIAL",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "studio_albums",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Validate Studio Payload').item.json.album_id }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "published"
            },
            {
              "fieldId": "publishing_status",
              "fieldValue": "published"
            },
            {
              "fieldId": "updated_at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "name": "Mark Studio Album Published",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1700,
        220
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_WITH_YOUR_HUB_SUPABASE_CREDENTIAL",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "studio_jobs",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Validate Studio Payload').item.json.job_id }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "completed"
            },
            {
              "fieldId": "progress",
              "fieldValue": "100"
            },
            {
              "fieldId": "completed_at",
              "fieldValue": "={{ $now.toISO() }}"
            },
            {
              "fieldId": "updated_at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "name": "Complete Studio Publish Job",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1920,
        220
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_WITH_YOUR_HUB_SUPABASE_CREDENTIAL",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $('Studio Publish Webhook').item.json.body || {}; const e = $json || {}; const err = e.error || {}; const reason = Array.isArray(err.errors) && err.errors[0] ? (err.errors[0].reason || err.errors[0].message) : ''; const message = String(err.message || err.description || reason || (typeof e.error === 'string' ? e.error : '') || 'Studio publishing workflow failed').replace(/\\s+/g, ' ').trim().slice(0, 500); return { json: { publication_id: b.publication_id, album_id: b.album_id, job_id: b.job_id, message } };"
      },
      "name": "Build Studio Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        560
      ]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "studio_publications",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Build Studio Failure').item.json.publication_id }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "failed"
            },
            {
              "fieldId": "error_message",
              "fieldValue": "={{ $('Build Studio Failure').item.json.message }}"
            },
            {
              "fieldId": "updated_at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "name": "Fail Studio Publication",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1260,
        560
      ],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_WITH_YOUR_HUB_SUPABASE_CREDENTIAL",
          "name": "Supabase account"
        }
