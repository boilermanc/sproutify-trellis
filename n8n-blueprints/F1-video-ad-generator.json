    {
      "parameters": {
        "jsCode": "const body = $('Webhook').item.json.body;\nconst brandItem = $('Lookup Brand Profile').all()[0];\nconst brand = brandItem ? brandItem.json : {};\nconst brandName = brand.brand_name || body.branch || 'the brand';\nconst tone = body.tone || brand.default_tone || 'friendly';\nconst pron = brand.pronunciation_guide || '';\nconst dur = (Number(body.video_duration) || 10) <= 5 ? 5 : 10;\nconst maxWords = Math.floor(dur * 2.5);\nconst hook = body.platform === 'tiktok'\n  ? 'Write a HOOK-FIRST viral vertical video script that grabs attention in the first 2 seconds. Punchy, conversational, fast-paced.'\n  : 'Write a performance-marketing video ad script.';\nconst script_prompt = `${hook} Brand: ${brandName}. Product: ${body.product_description || ''}. Audience: ${body.target_segment || 'general audience'}. Tone: ${tone}. Call to action: ${body.cta || 'Learn more'}. Pronunciation and brand rules: ${pron}. Write ONLY the spoken words - no stage directions, no parentheticals like (smiling), no narrator labels. Maximum ${maxWords} words. Conversational, natural.`;\nreturn [{ json: { script_prompt, brand_name: brandName, duration: String(dur), pipeline: body.pipeline || 'talking_head' } }];"
      },
      "id": "b7a1e2c3-1111-4a22-9c33-aaaaaaaaaaaa",
      "name": "Prepare Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -700,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: $json.script_prompt }] }], generationConfig: { temperature: 0.8, maxOutputTokens: 500 } }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "6dd8c7ec-60c4-4a71-bf35-4a8ca66f48f7",
      "name": "Generate Script (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
